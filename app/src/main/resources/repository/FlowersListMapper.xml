<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kozinkaihatsu.app.repository.view.FlowersListMapper">
   <select id="selectFlowers" resultType="com.kozinkaihatsu.Record.FlowersListRecord">
    SELECT * FROM kozinkaihatsu.flower_list
    <where>
        <if test="form.selectColor ! = null">
            AND color_id = #{form.selectColor}
        </if>
        <!-- <if test="form.flowerName != null">
            AND flower_name LIKE CONCAT('%', #{form.flowerName}, '%')
        </if> -->
    </where>
</select>

</mapper>