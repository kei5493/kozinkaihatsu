<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kozinkaihatsu.app.repository.common.FlowerLanguageMapper">
    <select id="selectAllFlowerLanguage" resultType="com.kozinkaihatsu.app.Record.FlowerLanguageRecord">
        SELECT DISTINCT
            language_id AS languageId,
            language AS language
        FROM
            kozinkaihatsu.flower_language
        ORDER BY
            language;
    </select>
</mapper>